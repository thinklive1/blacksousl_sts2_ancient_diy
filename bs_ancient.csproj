<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <!-- 如果你安装了10.0并遇到问题，改下这里 -->
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>true</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <!-- 改成你的杀戮尖塔2目录 -->
    <Sts2Dir>D:\software\steam\steamapps\common\Slay the Spire 2</Sts2Dir>
    <Sts2DataDir>$(Sts2Dir)\data_sts2_windows_x86_64</Sts2DataDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(Sts2DataDir)\sts2.dll</HintPath>
      <Private>true</Private>
    </Reference>

    <Reference Include="0Harmony">
      <HintPath>$(Sts2DataDir)\0Harmony.dll</HintPath>
      <Private>true</Private>
    </Reference>

  <!-- 本地引用，注意路径是否正确 -->
  <!-- <Reference Include="STS2-RitsuLib">
    <HintPath>$(Sts2Dir)/mods/RitsuLib/STS2-RitsuLib.dll</HintPath>
    <Private>false</Private>
  </Reference> -->
  <!-- NuGet获取，注意版本是否一致，不一致手动更改Version 
  <PackageReference Include="STS2.RitsuLib" Version="*" /> -->
  <!-- 如果你在正式版开发用这个 -->
  <PackageReference Include="STS2.RitsuLib.Compat.0.103.2" Version="0.3.0" />
  <PackageReference Include="Nothing.STS2RitsuLib.ModAnalyzers" Version="0.7.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- 自动复制dll、json和README -->
  <Target Name="Copy Mod" AfterTargets="PostBuildEvent">
    <Message Text="Copying mod to Slay the Spire 2 mods folder..." Importance="high" />
    <MakeDir Directories="$(Sts2Dir)\mods\" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(Sts2Dir)\mods\$(MSBuildProjectName)\" />
    <Copy SourceFiles="$(MSBuildProjectName).json" DestinationFolder="$(Sts2Dir)/mods/$(MSBuildProjectName)/" />
    <Copy SourceFiles="README.md" DestinationFolder="$(Sts2Dir)/mods/$(MSBuildProjectName)/" />
    <Delete Files="$(Sts2Dir)\mods\$(MSBuildProjectName)\$(MSBuildProjectName)_config.json" TreatErrorsAsWarnings="true" />
  </Target>
</Project>
