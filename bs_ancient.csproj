<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <!-- 如果你安装了10.0并遇到问题，改下这里 -->
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>true</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AssemblyName>bs_ancient.impl.1071</AssemblyName>
    <RootNamespace>BlackSouls</RootNamespace>
    <DefineConstants>$(DefineConstants);BS_STABLE_1071</DefineConstants>

    <!-- 改成你的杀戮尖塔2目录 -->
    <Sts2Dir>D:\software\steam\steamapps\common\Slay the Spire 2</Sts2Dir>
    <GodotExe>D:\game\bsmod\Godot_v4.5.1-stable_mono_win64\Godot_v4.5.1-stable_mono_win64_console.exe</GodotExe>
    <Sts2DataDir>$(Sts2Dir)\data_sts2_windows_x86_64</Sts2DataDir>
    <WorkshopUploadContentDir>$(MSBuildProjectDirectory)\upload\content</WorkshopUploadContentDir>
    <ModInstallDir>$(Sts2Dir)\mods\bs_ancient</ModInstallDir>
    <CompatibilityBundleDir>$(IntermediateOutputPath)compatibility_bundle</CompatibilityBundleDir>
    <StableImplementationName>bs_ancient.impl.dll</StableImplementationName>
    <BetaImplementationName>bs_ancient.impl.dll</BetaImplementationName>
  </PropertyGroup>

  <!-- Godot 导出 PCK 时会执行一次内部 publish；这里仅构建资源程序集，避免递归组装和部署双版本 DLL。 -->
  <PropertyGroup Condition="'$(IsInnerGodotExport)' == 'true'">
    <SkipCompatibilityBundle>true</SkipCompatibilityBundle>
    <SkipModDeployment>true</SkipModDeployment>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="compat\**\*.cs" />

  <!-- 固定 RitsuLib 版本，避免 Version="*" 在发布时绑定到玩家未安装的新程序集版本 -->
  <PackageReference Include="BSchneppe.Sts2.ReferenceAssemblies" Version="0.107.1" PrivateAssets="all" />
  <PackageReference Include="STS2.RitsuLib.Compat.0.107.1" Version="0.6.9" />
  <PackageReference Include="Nothing.STS2RitsuLib.ModAnalyzers" Version="0.7.0" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="BuildCompatibilityImplementations"
          Condition="'$(SkipCompatibilityBundle)' != 'true'">
    <MSBuild Projects="$(MSBuildProjectDirectory)\compat\bs_ancient.Beta\bs_ancient.Beta.csproj;$(MSBuildProjectDirectory)\compat\bs_ancient.Loader\bs_ancient.Loader.csproj"
             Targets="Build"
             BuildInParallel="true"
             Properties="Configuration=$(Configuration);SkipModDeployment=true;SkipCompatibilityBundle=true" />
  </Target>

  <Target Name="PrepareCompatibilityBundle"
          DependsOnTargets="BuildCompatibilityImplementations"
          Condition="'$(SkipCompatibilityBundle)' != 'true'">
    <RemoveDir Directories="$(CompatibilityBundleDir)" />
    <MakeDir Directories="$(CompatibilityBundleDir);$(CompatibilityBundleDir)\compat\0.107.1;$(CompatibilityBundleDir)\compat\0.111.0" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\compat\bs_ancient.Loader\bin\$(Configuration)\net9.0\bs_ancient.dll"
          DestinationFiles="$(CompatibilityBundleDir)\bs_ancient.dll" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFiles="$(CompatibilityBundleDir)\compat\0.107.1\$(StableImplementationName)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\compat\bs_ancient.Beta\.godot\mono\temp\bin\$(Configuration)\bs_ancient.impl.1110.dll"
          DestinationFiles="$(CompatibilityBundleDir)\compat\0.111.0\$(BetaImplementationName)" />
  </Target>

  <!-- Godot 根据 project.godot 查找 bs_ancient.dll；临时别名只用于通过资源导出检查，不进入 Mod 部署目录。 -->
  <Target Name="CreateGodotExportAssemblyAlias"
          AfterTargets="Publish"
          Condition="'$(IsInnerGodotExport)' == 'true' and '$(AssemblyName)' != 'bs_ancient' and Exists('$(PublishDir)$(AssemblyName).dll')">
    <Copy SourceFiles="$(PublishDir)$(AssemblyName).dll"
          DestinationFiles="$(PublishDir)bs_ancient.dll" />
  </Target>

  <!-- 自动复制双版本 DLL、json 和 README。 -->
  <Target Name="CopyMod"
          AfterTargets="Build"
          DependsOnTargets="PrepareCompatibilityBundle"
          Condition="'$(SkipModDeployment)' != 'true' and '$(SkipCompatibilityBundle)' != 'true'">
    <ItemGroup>
      <_CompatibilityBundleFiles Include="$(CompatibilityBundleDir)\**\*" />
    </ItemGroup>
    <Message Text="Copying mod to Steam Workshop uploader workspace..." Importance="high" />
    <MakeDir Directories="$(WorkshopUploadContentDir)" />
    <RemoveDir Directories="$(WorkshopUploadContentDir)\compat" />
    <RemoveDir Directories="$(WorkshopUploadContentDir)\docs" />
    <Delete Files="$(WorkshopUploadContentDir)\bs_ancient_config.cfg" TreatErrorsAsWarnings="true" />
    <Copy SourceFiles="@(_CompatibilityBundleFiles)"
          DestinationFiles="@(_CompatibilityBundleFiles->'$(WorkshopUploadContentDir)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="bs_ancient.json" DestinationFolder="$(WorkshopUploadContentDir)\" />
    <Copy SourceFiles="README.md" DestinationFolder="$(WorkshopUploadContentDir)\" />
    <Copy SourceFiles="README_EN.md" DestinationFolder="$(WorkshopUploadContentDir)\" />
    <Copy SourceFiles="$(ModInstallDir)\bs_ancient.pck" DestinationFolder="$(WorkshopUploadContentDir)\" Condition="Exists('$(ModInstallDir)\bs_ancient.pck')" />

    <Message Text="Copying mod to Slay the Spire 2 mods folder..." Importance="high" />
    <MakeDir Directories="$(ModInstallDir)" />
    <RemoveDir Directories="$(ModInstallDir)\compat" />
    <RemoveDir Directories="$(ModInstallDir)\docs" />
    <Copy SourceFiles="@(_CompatibilityBundleFiles)"
          DestinationFiles="@(_CompatibilityBundleFiles->'$(ModInstallDir)\%(RecursiveDir)%(Filename)%(Extension)')"
          ContinueOnError="WarnAndContinue" />
    <Copy SourceFiles="bs_ancient.json" DestinationFolder="$(ModInstallDir)\" ContinueOnError="WarnAndContinue" />
    <Copy SourceFiles="README.md" DestinationFolder="$(ModInstallDir)\" ContinueOnError="WarnAndContinue" />
    <Copy SourceFiles="README_EN.md" DestinationFolder="$(ModInstallDir)\" ContinueOnError="WarnAndContinue" />
    <Delete Files="$(ModInstallDir)\bs_ancient_config.json" TreatErrorsAsWarnings="true" />
  </Target>

  <!-- 手动执行 dotnet build -t:ExportPck 时，使用 Godot headless 导出 PCK。普通 dotnet build 不会触发。 -->
  <Target Name="ExportPck" DependsOnTargets="Build;PrepareCompatibilityBundle;CopyMod">
    <Message Text="Exporting PCK to Slay the Spire 2 mods folder..." Importance="high" />
    <MakeDir Directories="$(ModInstallDir)\" />
    <Exec Command="&quot;$(GodotExe)&quot; --headless --path &quot;$(MSBuildProjectDirectory)&quot; --export-pack &quot;Windows Desktop&quot; &quot;$(ModInstallDir)\bs_ancient.pck&quot;"
      EnvironmentVariables="IsInnerGodotExport=true;MSBUILDDISABLENODEREUSE=1"
      ContinueOnError="WarnAndContinue"
      Condition="Exists('$(GodotExe)')" />
    <Warning Text="GodotExe not found: $(GodotExe)" Condition="!Exists('$(GodotExe)')" />
    <Copy SourceFiles="$(ModInstallDir)\bs_ancient.pck" DestinationFolder="$(WorkshopUploadContentDir)\" Condition="Exists('$(ModInstallDir)\bs_ancient.pck')" />
  </Target>
</Project>
