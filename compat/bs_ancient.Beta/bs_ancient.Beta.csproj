<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>true</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>bs_ancient.impl.1110</AssemblyName>
    <RootNamespace>BlackSouls</RootNamespace>
    <DefineConstants>$(DefineConstants);BS_BETA_1110</DefineConstants>
    <GodotProjectDir>$(MSBuildThisFileDirectory)..\..</GodotProjectDir>
    <GodotSourceGenerators>disabled</GodotSourceGenerators>
    <!-- Resource paths are validated by the root Godot project; this linked-source build has no local asset index. -->
    <NoWarn>$(NoWarn);RITSU013</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="GodotProjectDir" />
    <CompilerVisibleProperty Include="GodotSourceGenerators" />
    <Compile Include="..\..\Scripts\**\*.cs" />
    <Compile Include="..\..\Properties\AssemblyInfo.cs" />
    <PackageReference Include="BSchneppe.Sts2.ReferenceAssemblies" Version="0.111.0-beta-41cef1ea" PrivateAssets="all" />
    <PackageReference Include="STS2.RitsuLib.Compat.0.111.0" Version="0.6.11" />
    <PackageReference Include="Nothing.STS2RitsuLib.ModAnalyzers" Version="0.7.0" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="ExportPck" />
</Project>
