<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>true</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AssemblyName>bs_ancient.impl.1130</AssemblyName>
    <RootNamespace>BlackSouls</RootNamespace>
    <DefineConstants>$(DefineConstants);BS_BETA_1110;BS_BETA_1130</DefineConstants>
    <GodotProjectDir>$(MSBuildThisFileDirectory)..\..</GodotProjectDir>
    <GodotSourceGenerators>disabled</GodotSourceGenerators>
    <NoWarn>$(NoWarn);RITSU013</NoWarn>
    <Sts2Api113Root Condition="'$(Sts2Api113Root)' == ''">$(MSBuildThisFileDirectory)..\..\archive\game-api\0.113.0</Sts2Api113Root>
    <Sts2Api113DataDir>$(Sts2Api113Root)\data_sts2_windows_x86_64</Sts2Api113DataDir>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="GodotProjectDir" />
    <CompilerVisibleProperty Include="GodotSourceGenerators" />
    <Compile Include="..\..\Scripts\**\*.cs" />
    <Compile Include="..\..\Properties\AssemblyInfo.cs" />
    <PackageReference Include="STS2.RitsuLib" Version="0.6.11" />
    <PackageReference Include="Nothing.STS2RitsuLib.ModAnalyzers" Version="0.7.0" PrivateAssets="all" />
    <Reference Include="sts2" HintPath="$(Sts2Api113DataDir)\sts2.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(Sts2Api113DataDir)\0Harmony.dll" Private="false" />
    <Reference Include="SmartFormat" HintPath="$(Sts2Api113DataDir)\SmartFormat.dll" Private="false" />
    <Reference Include="Steamworks.NET" HintPath="$(Sts2Api113DataDir)\Steamworks.NET.dll" Private="false" />
  </ItemGroup>
  <Target Name="ValidateGameApi" BeforeTargets="ResolveReferences">
    <PropertyGroup>
      <_GameReleaseData>$([System.IO.File]::ReadAllText('$(Sts2Api113Root)\release_info.json'))</_GameReleaseData>
    </PropertyGroup>
    <Error Condition="!$(_GameReleaseData.Contains('v0.113.'))" Text="The 0.113 implementation requires game API 0.113. Set Sts2Api113Root to a 0.113 installation or its archived API directory." />
  </Target>
  <Target Name="ExportPck" />
</Project>
